{
  "name": "carambolage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:test": "tsc --noEmit && vite build --mode open-all",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:single && playwright test",
    "smoke": "npm run build:single && playwright test --grep @boot",
    "android": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android && node tools/android-apk.mjs",
    "android:aab": "npm run android && node tools/android-apk.mjs aab",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor \"#1b1530\" --iconBackgroundColorDark \"#1b1530\" --splashBackgroundColor \"#1b1530\" --splashBackgroundColorDark \"#1b1530\""
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2"
  }
}
